{
  "name": "glyphx",
  "version": "0.4.0",
  "description": "A fast, keyboard-first, Spotlight-style command palette for React",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": {
    "name": "Ashutosh Gupta",
    "email": "aguptaworkspace@gmail.com",
    "url": "https://github.com/imAshutoshGupta"
  },
  "homepage": "https://github.com/imAshutoshGupta/glyphx#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imAshutoshGupta/glyphx.git"
  },
  "bugs": {
    "url": "https://github.com/imAshutoshGupta/glyphx/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.umd.js",
  "jsdelivr": "./dist/index.umd.js",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./style.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite --mode site",
    "build": "vite build && vite build --mode umd",
    "build:site": "vite build --mode site && vite build --mode prerender && node scripts/prerender-site.mjs",
    "preview": "vite preview --mode site",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "verify:dist": "node scripts/verify-dist.mjs",
    "prepublishOnly": "npm run build && npm run verify:dist && npm test"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-visually-hidden": "^1.2.4",
    "fuzzysort": "^3.1.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.60.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^5.0.2",
    "vitest": "^4.1.8"
  },
  "keywords": [
    "react",
    "command-palette",
    "keyboard",
    "spotlight",
    "ui",
    "accessibility",
    "fuzzy-search",
    "radix-ui",
    "zustand",
    "frontend",
    "developer-tools"
  ]
}
